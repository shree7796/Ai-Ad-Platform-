# Copy to .env.local to override. Next also loads .env.development when present.
#
# Server-side API origin (proxy target). Not exposed to the browser.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Alternative name (docker-compose sets this in containers):
# API_PROXY_TARGET=http://127.0.0.1:8000
#
# Docker Desktop: if the API is on the host and 127.0.0.1 fails from the frontend container, try:
# BACKEND_INTERNAL_URL=http://host.docker.internal:8000
#
# Default browser API base (see src/lib/api.ts); same-origin proxy is recommended:
# NEXT_PUBLIC_API_URL=/api/v1
