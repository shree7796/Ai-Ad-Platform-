# =========================================
# AI Ad Generation Platform - Environment
# =========================================

# --- App ---
APP_NAME=ai-ad-generator
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-secure-random-string
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
POSTGRES_USER=adgen
POSTGRES_PASSWORD=adgen_secret
POSTGRES_DB=adgen_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/1

# --- Object Storage (S3-compatible / MinIO) ---
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=adgen-media
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000

# --- JWT Auth ---
JWT_SECRET=change-me-to-a-secure-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- LLM / Prompt Enhancement ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-openai-key-here

# --- Video Model (Active) ---
VIDEO_MODEL_PROVIDER=mock
# Options: mock, pika, runway

# --- Pika (when ready) ---
PIKA_API_KEY=
PIKA_API_URL=https://api.pika.art/v1

# --- Runway (when ready) ---
RUNWAY_API_KEY=
RUNWAY_API_URL=https://api.runwayml.com/v1

# --- FFmpeg ---
FFMPEG_PATH=/usr/bin/ffmpeg

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
